# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never paste a key anywhere else.

# GitHub fine-grained personal access token, read-only (Public repositories access).
GITHUB_TOKEN=

# Stack Exchange key: register an app at https://stackapps.com/apps/oauth/register and copy its key.
# Free. Without it the API allows 300 requests/day instead of 10,000.
STACKEXCHANGE_KEY=
